{
  "name": "@deepseek-ai/dsh-subprocess-native",
  "description": "Native-execution provider for the DeepSeek Harness subprocess seam",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
