{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://888.local/schema/worker/job-dispatch.schema.json",
  "title": "JobDispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "protocol_version",
    "type",
    "input_refs",
    "parameters",
    "artifact_ids"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "object"
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "checkpoint_artifact_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  }
}
