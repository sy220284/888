{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://888.local/schema/world/candidate.schema.json",
  "title": "Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "world_id",
    "candidate_type",
    "artifact_ids",
    "payload",
    "status",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "world_id": {
      "type": "string",
      "format": "uuid"
    },
    "candidate_type": {
      "type": "string",
      "enum": [
        "GEOMETRY",
        "MATERIAL",
        "WORLD_COMPLETION",
        "ENTITY",
        "RELATION",
        "AUDIO",
        "TEXTURE"
      ]
    },
    "source_job_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "provider_run_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "payload": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACCEPTED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
