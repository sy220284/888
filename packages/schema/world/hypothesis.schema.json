{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://888.local/schema/world/hypothesis.schema.json",
  "title": "Hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "world_id",
    "hypothesis_type",
    "status",
    "score",
    "uncertainty",
    "payload",
    "supporting_evidence_ids",
    "contradicting_evidence_ids",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "world_id": {
      "type": "string",
      "format": "uuid"
    },
    "hypothesis_type": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "VERIFIED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "payload": {
      "type": "object"
    },
    "supporting_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "contradicting_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
