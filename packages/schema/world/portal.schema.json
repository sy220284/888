{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://888.local/schema/world/portal.schema.json",
  "title": "Portal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "world_id",
    "from_zone_id",
    "transform",
    "passable",
    "confidence",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "world_id": {
      "type": "string",
      "format": "uuid"
    },
    "from_zone_id": {
      "type": "string",
      "format": "uuid"
    },
    "to_zone_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "anchor_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "transform": {
      "type": "object"
    },
    "passable": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
