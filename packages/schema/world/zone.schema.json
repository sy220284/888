{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://888.local/schema/world/zone.schema.json",
  "title": "Zone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "world_id",
    "zone_type",
    "local_transform",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "world_id": {
      "type": "string",
      "format": "uuid"
    },
    "zone_type": {
      "type": "string",
      "enum": [
        "ROOM",
        "CORRIDOR",
        "FLOOR",
        "BUILDING",
        "OUTDOOR",
        "GARDEN",
        "STREET",
        "UNKNOWN"
      ]
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "local_transform": {
      "type": "object"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
