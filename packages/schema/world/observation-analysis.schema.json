{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://888.local/schema/world/observation-analysis.schema.json",
  "title": "ObservationAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "observation_id",
    "source_artifact_id",
    "status",
    "exif",
    "quality",
    "analyzer_version",
    "analyzed_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "observation_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "PARTIAL",
        "FAILED"
      ]
    },
    "preview_artifact_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "width": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "height": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "orientation": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 8
    },
    "captured_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "exif": {
      "type": "object"
    },
    "quality": {
      "type": "object"
    },
    "analyzer_version": {
      "type": "string",
      "minLength": 1
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "analyzed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
