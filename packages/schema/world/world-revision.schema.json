{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://888.local/schema/world/world-revision.schema.json",
  "title": "WorldRevision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "world_id",
    "actor_type",
    "changeset",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "world_id": {
      "type": "string",
      "format": "uuid"
    },
    "parent_revision_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "command_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "actor_type": {
      "type": "string",
      "enum": [
        "USER",
        "SYSTEM",
        "AGENT"
      ]
    },
    "changeset": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
