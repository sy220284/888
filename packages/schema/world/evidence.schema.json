{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://888.local/schema/world/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "world_id",
    "type",
    "subject_ref",
    "object_ref",
    "weight",
    "payload",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "world_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "object_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_job_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "payload": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "invalidated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
