{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://888.local/schema/world/world.schema.json",
  "title": "World",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "schema_version",
    "coordinate_system",
    "unit",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "active_revision_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "coordinate_system": {
      "type": "string",
      "enum": [
        "RIGHT_HANDED_Y_UP"
      ]
    },
    "unit": {
      "type": "string",
      "enum": [
        "METER"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
