{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://888.local/schema/task/job.schema.json",
  "title": "Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "task_type",
    "input",
    "state",
    "attempt",
    "max_attempts",
    "idempotent",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "world_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    },
    "state": {
      "type": "string",
      "enum": [
        "CREATED",
        "PENDING",
        "READY",
        "RUNNING",
        "PAUSING",
        "PAUSED",
        "RECOVERABLE",
        "FAILED",
        "CANCELLED",
        "COMPLETED",
        "BLOCKED",
        "WAITING_RESOURCE",
        "WAITING_PROVIDER",
        "WAITING_USER"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "idempotent": {
      "type": "boolean"
    },
    "assigned_worker_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "checkpoint_artifact_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "provider_run_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_payload": {},
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
